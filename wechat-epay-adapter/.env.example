# Public HTTP contract
DATABASE_TYPE=mysql
DATABASE_DSN=wechat_epay:replace-with-database-password@tcp(mysql:3306)/wechat_epay_adapter?charset=utf8mb4&parseTime=True&loc=UTC
HTTP_LISTEN_ADDR=:8080
TRUSTED_PROXY_CIDRS=127.0.0.1/32
PUBLIC_BASE_URL=https://pay.example.com
# Comma-separated allowlist. new-api registers one callback path per business flow,
# so list every flow the deployment sells through WeChat Pay.
NEW_API_NOTIFY_URL=https://api.example.com/api/user/epay/notify,https://api.example.com/api/subscription/epay/notify
# Comma-separated origin plus path prefix allowlist. Wallet top-up returns to the
# console and subscription purchase returns to /api/subscription/epay/return.
RETURN_URL_ALLOWLIST=https://api.example.com/console/,https://api.example.com/api/subscription/epay/return
MAX_ORDER_AMOUNT_YUAN=5000.00

# Epay contract shared with new-api
EPAY_PARTNER_ID=replace-with-merchant-id
EPAY_KEY=replace-with-secret

# WeChat Pay API v3 Native contract
WECHAT_APP_ID=replace-with-app-id
WECHAT_MCH_ID=replace-with-merchant-id
WECHAT_MCH_CERT_SERIAL=replace-with-certificate-serial
WECHAT_MCH_PRIVATE_KEY_FILE=/run/secrets/wechat_merchant_private_key.pem
WECHAT_API_V3_KEY=replace-with-32-byte-api-v3-key
WECHAT_NOTIFY_URL=https://pay.example.com/api/v1/wechat/notify
WECHAT_VERIFY_MODE=public_key
WECHAT_PUBLIC_KEY_ID=replace-with-public-key-id
WECHAT_PUBLIC_KEY_FILE=/run/secrets/wechat_pay_public_key.pem
# During a WeChat public-key rotation, mount the prior valid material, roll all instances,
# then remove both settings only after WeChat is no longer signing with the prior key ID.
WECHAT_PREVIOUS_PUBLIC_KEY_ID=
WECHAT_PREVIOUS_PUBLIC_KEY_FILE=

# Protected operational endpoints
# Rotate protected endpoint tokens with a rolling deployment and an upstream gateway overlap.
ADMIN_API_TOKEN=replace-with-high-entropy-token
METRICS_API_TOKEN=replace-with-high-entropy-token

# Runtime defaults
NOTIFICATION_WORKERS=2
LOG_LEVEL=info
LOG_DIR=./logs
