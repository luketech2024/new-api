# ============================================================
# WeChat Epay Adapter 环境变量
#   复制此文件为 .env 并替换所有占位符
#   cp .env.example .env
#
#   注意: DATABASE_TYPE / DATABASE_DSN / HTTP_LISTEN_ADDR
#   由 docker-compose.yml 的 environment 段统一管理, 此处不设
# ============================================================

# -------------------- 域名与回调 --------------------
# adapter 的公网 HTTPS 地址 (必须 https://)
PUBLIC_BASE_URL=https://pay.example.com
# 支付成功后回调 new-api 的接口 (必须 https://, 逗号分隔)
# new-api 的钱包充值与订阅购买各自使用独立的回调路径, 需要同时列出,
# 否则未列出的那条流程会在进单时被拒绝
#   钱包充值: https://<new-api域名>/api/user/epay/notify
#   订阅购买: https://<new-api域名>/api/subscription/epay/notify
NEW_API_NOTIFY_URL=https://api.example.com/api/user/epay/notify,https://api.example.com/api/subscription/epay/notify
# 支付完成跳转回的前端域名 (逗号分隔)
# 订阅购买的 return_url 为 https://<new-api域名>/api/subscription/epay/return,
# 若此处收窄到具体路径前缀, 需同时放行该路径
RETURN_URL_ALLOWLIST=https://api.example.com/

# -------------------- Epay (易支付) 配置 --------------------
EPAY_PARTNER_ID=10001
EPAY_KEY=replace-with-your-epay-key

# -------------------- 订单限制 --------------------
MAX_ORDER_AMOUNT_YUAN=5000.00

# -------------------- 微信支付配置 --------------------
WECHAT_APP_ID=replace-with-your-app-id
WECHAT_MCH_ID=replace-with-your-mch-id
WECHAT_MCH_CERT_SERIAL=replace-with-cert-serial
# 私钥/公钥文件路径 (挂载在 /run/secrets/)
WECHAT_MCH_PRIVATE_KEY_FILE=/run/secrets/wechat_merchant_private_key.pem
WECHAT_PUBLIC_KEY_FILE=/run/secrets/wechat_pay_public_key.pem
# APIv3 密钥 (必须 32 字节)
WECHAT_API_V3_KEY=replace-with-32byte-api-v3-key
# 微信异步通知地址 (必须 https://)
WECHAT_NOTIFY_URL=https://pay.example.com/api/v1/wechat/notify
# 验签模式: 固定 public_key
WECHAT_VERIFY_MODE=public_key
WECHAT_PUBLIC_KEY_ID=replace-with-public-key-id

# -------------------- 密钥轮换 (可选) --------------------
WECHAT_PREVIOUS_PUBLIC_KEY_ID=
WECHAT_PREVIOUS_PUBLIC_KEY_FILE=

# -------------------- 管理 API 令牌 --------------------
# 各自至少 32 字节, 请用随机字符串
ADMIN_API_TOKEN=replace-with-random-32+byte-token
METRICS_API_TOKEN=replace-with-random-32+byte-token

# -------------------- 可信代理 --------------------
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# -------------------- 工作线程与日志 --------------------
NOTIFICATION_WORKERS=2
LOG_LEVEL=info
