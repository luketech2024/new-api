# ============================================================
# New-API 全栈部署环境变量
#   复制此文件为 .env 并修改所有占位符
#   cp .env.example .env
# ============================================================

# -------------------- 域名 --------------------
# new-api 前端访问域名 (nginx 反向代理目标)
NEW_API_DOMAIN=api.example.com
# wechat-epay-adapter 支付域名
PAY_DOMAIN=pay.example.com

# -------------------- SSL 证书 --------------------
# 证书文件名 (放在 nginx/certs/ 目录下)
SSL_CERT=fullchain.pem
SSL_KEY=privkey.pem

# -------------------- MySQL --------------------
MYSQL_ROOT_PASSWORD=ChangeThisRootPwd_2026!
# new-api 数据库
NEW_API_DB_NAME=new_api
NEW_API_DB_USER=newapi
NEW_API_DB_PASSWORD=ChangeThisPwd_2026!
# wechat-epay-adapter 数据库
WECHAT_DB_NAME=wechat_epay
WECHAT_DB_USER=wechat_epay
WECHAT_DB_PASSWORD=ChangeThisPwd_2026!

# -------------------- Redis --------------------
REDIS_PASSWORD=ChangeThisRedisPwd_2026!

# -------------------- New-API 会话 --------------------
# 生产环境 (HTTPS) 设为 true, 并填写 TRUSTED_URL
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
# 首次启动是否自动生成默认 Token
GENERATE_DEFAULT_TOKEN=false

# ============================================================
# 以下变量在 wechat-adapter/.env 中配置 (由 adapter 读取)
# 这里仅做说明, 不在此文件设置
# ============================================================
# EPAY_PARTNER_ID, EPAY_KEY, WECHAT_APP_ID, WECHAT_MCH_ID
# WECHAT_MCH_CERT_SERIAL, WECHAT_API_V3_KEY, WECHAT_NOTIFY_URL
# WECHAT_VERIFY_MODE, WECHAT_PUBLIC_KEY_ID
# PUBLIC_BASE_URL, NEW_API_NOTIFY_URL, RETURN_URL_ALLOWLIST
# MAX_ORDER_AMOUNT_YUAN, ADMIN_API_TOKEN, METRICS_API_TOKEN
